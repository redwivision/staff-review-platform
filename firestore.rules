rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ---- USERS ----
    // Staff can create their own profile on signup.
    // Once created, only admins can change roles.
    match /users/{userId} {
      // Create: only yourself (signup)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Read: anyone logged in (needed for role checks)
      allow read: if isAuthenticated();
      // Update: yourself (name, etc.) OR admin changing roles
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isLeader', 'isAdmin', 'role'])
      );
      // Delete: no one
      allow delete: if false;
    }

    // ---- DEVELOPMENT REVIEWS ----
    match /developmentReviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ---- QUARTERLY SUMMARIES ----
    // Staff fills sections 1-4, submits to coach.
    // Coach fills TL Evaluation, submits to admin.
    match /quarterlySummaries/{summaryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ---- ACTIVITY LOGS ----
    match /activityLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if false;
    }

    // ---- FOLLOW-UP TASKS ----
    match /followUpTasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ---- REQUIREMENT SETTINGS ----
    match /requirementSettings/{settingsId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ---- REVIEW SCHEDULES ----
    match /reviewSchedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ---- MEETINGS ----
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ---- COACHING REQUESTS ----
    match /coachingRequests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
